# Aiven MySQL connection details. Do not commit a real .env file.
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
DB_HOST=your-aiven-host.aivencloud.com
DB_PORT=12345
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASSWORD=replace-with-your-password
# Aiven requires TLS. Download the CA Certificate from Aiven Console > service > Overview > Connection information.
# Use an absolute Windows path, for example C:\\Users\\your-name\\Downloads\\aiven-ca.pem.
DB_SSL=true
DB_SSL_CA=C:\\path\\to\\aiven-ca.pem

# First instructor account created by `npm run setup`.
ADMIN_NAME=StepUp Instructor
ADMIN_EMAIL=instructor@example.com
ADMIN_PASSWORD=change-this-before-setup
JWT_SECRET=replace-with-a-long-random-secret
